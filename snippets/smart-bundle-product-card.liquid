{%- comment -%}
  Smart Bundle Builder product card.

  Required:
  - product: Product
  - section_id: String
  - index: Number
{%- endcomment -%}

{%- liquid
  assign card_id = 'sb-card-' | append: section_id | append: '-' | append: product.id
  assign featured = product.featured_media
  assign selected_variant = product.selected_or_first_available_variant
  assign price_cents = selected_variant.price
-%}

<article
  class="smart-bundle__card"
  role="listitem"
  data-product-id="{{ product.id }}"
  aria-labelledby="{{ card_id }}-title"
>
  <div class="smart-bundle__media">
    {%- if featured -%}
      {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
      <img
        srcset="
          {%- if featured.width >= 240 -%}{{ featured | image_url: width: 240 }} 240w,{%- endif -%}
          {%- if featured.width >= 360 -%}{{ featured | image_url: width: 360 }} 360w,{%- endif -%}
          {%- if featured.width >= 480 -%}{{ featured | image_url: width: 480 }} 480w,{%- endif -%}
          {{ featured | image_url: width: 600 }} 600w
        "
        src="{{ featured | image_url: width: 480 }}"
        sizes="(min-width: 990px) 25vw, (min-width: 750px) 50vw, 80vw"
        alt="{{ featured.alt | escape }}"
        width="{{ featured.width }}"
        height="{{ featured.height }}"
        loading="lazy"
        class="smart-bundle__img"
      >
      {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}
    {%- else -%}
      <div class="smart-bundle__img smart-bundle__img--placeholder">
        {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}

    <div class="smart-bundle__badge" data-sold-out-badge hidden>
      <span class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}">
        {{- 'products.product.sold_out' | t -}}
      </span>
    </div>
  </div>

  <div class="smart-bundle__card-body">
    <div class="smart-bundle__card-top">
      <h3 class="smart-bundle__card-title h5" id="{{ card_id }}-title">
        <a href="{{ product.url }}" class="full-unstyled-link">
          {{ product.title | escape }}
        </a>
      </h3>
      <div class="smart-bundle__price" data-price-cents="{{ price_cents }}" data-card-price-wrap>
        {% render 'price', product: product, price_class: '', show_compare_at_price: true %}
      </div>
    </div>

    <div
      class="smart-bundle__options"
      data-option-pickers
      aria-label="Choose options for {{ product.title | escape }}"
    ></div>

    <div class="smart-bundle__actions">
      <button
        type="button"
        class="button button--secondary smart-bundle__add"
        data-add-to-bundle
        aria-label="Add {{ product.title | escape }} to bundle"
      >
        <span data-add-label>Add to bundle</span>
      </button>
      <button
        type="button"
        class="button button--secondary smart-bundle__remove"
        data-remove-from-bundle
        aria-label="Remove {{ product.title | escape }} from bundle"
        hidden
      >
        Remove
      </button>
    </div>
  </div>
</article>


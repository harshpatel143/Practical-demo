<product-card class="group">

    <div class="relative overflow-hidden rounded-2xl">

    <span
        class="absolute top-3 left-3 z-10 bg-white border border-gray-200 rounded-full px-3 py-1 text-[10px] font-semibold"
    >
        BEST SELLER
    </span>

    <img
        src="{{ product.featured_image | image_url: width: 800 }}"
        data-primary="{{ product.featured_image | image_url: width: 800 }}"
        data-hover="{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 800 }}{% else %}{{ product.featured_image | image_url: width: 800 }}{% endif %}"
        alt="{{ product.featured_image.alt | escape | default: product.title }}"
        loading="lazy"
        width="800"
        height="800"
        class="product-image w-full aspect-square object-cover rounded-2xl"
    />
    </div>

    <div class="pt-4">
    <h3 class="text-[16px] font-semibold uppercase leading-[1.4]">
        {{  product.title }}
    </h3>

    <div
        class="mt-2 text-sm text-gray-500"
        aria-label="Rated 5 out of 5 stars with 1234 reviews"
    >
        ★★★★★ 1,234 Reviews
    </div>

    <p class="mt-3 text-[16px] font-semibold">
        {{ product.price | money }}
    </p>
    </div>

</product-card>
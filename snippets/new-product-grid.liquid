<product-card class="group">

    <div class="relative overflow-hidden rounded-2xl">

    <span
        class="absolute top-3 left-3 z-10 bg-white border border-gray-200 rounded-full px-3 py-1 text-[10px] font-semibold"
    >
        BEST SELLER
    </span>

    <img
        src="{{ product.featured_image | ima}}"
        data-primary="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800"
        data-hover="https://images.unsplash.com/photo-1546435770-a3e426bf472b?w=800"
        alt="Wireless headphones"
        loading="lazy"
        class="product-image w-full aspect-square object-cover rounded-2xl"
    />
    </div>

    <div class="pt-4">
    <h3 class="text-[16px] font-semibold uppercase leading-[1.4]">
        {{  product.title }}
    </h3>

    <div
        class="mt-2 text-sm text-gray-500"
        aria-label="Rated 5 out of 5 stars with 1234 reviews"
    >
        ★★★★★ 1,234 Reviews
    </div>

    <p class="mt-3 text-[16px] font-semibold">
        {{ product.price | money }}
    </p>
    </div>

</product-card>
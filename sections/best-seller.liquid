{{ 'best-seller-section.css' | asset_url | stylesheet_tag }}
<script src="{{ 'best-seller-section.js' | asset_url }}" defer="defer"></script>

<div
    aria-labelledby="best-sellers-heading"
    class="custom-best-seller max-w-[1440px] mx-auto px-4 md:px-6 py-10 md:py-16"
>

    <!-- Header -->
    <header class="flex items-center justify-between mb-8 md:mb-10">

    <h2
        id="best-sellers-heading"
        class="text-[32px] md:text-[48px] font-black leading-none"
    >
        {{ section.settings.heading }}
    </h2>

    <a
        href="#"
        aria-label="Shop all best sellers products"
        class="hidden md:flex items-center gap-2 text-sm font-medium hover:underline"
    >
        Shop All Best Sellers
        <span aria-hidden="true">→</span>
    </a>

    </header>

    <!-- Swiper -->
    <div
    class="swiper productSwiper"
    aria-label="Best sellers products"
    >

    <div
        id="productWrapper"
        class="swiper-wrapper"
    >

        {% for product in  section.settings.collection.products %}
            <div class="swiper-slide{% if forloop.index >= 5 %} mobile-hidden{% endif %}">
                {% render 'new-product-grid', product: product %}
            </div>
        {% endfor %}


       

    </div>

    <!-- Desktop Scrollbar -->
    <div
        class="swiper-scrollbar mt-6 hidden md:block"
        aria-hidden="true"
    ></div>

    </div>

    <!-- Mobile Button -->
    <div class="mt-8 md:hidden">

    <button
        id="showMoreBtn"
        type="button"
        aria-expanded="false"
        aria-controls="productWrapper"
        class="
        w-full
        rounded-full
        bg-black
        text-white
        py-4
        text-[16px]
        font-semibold
        transition
        hover:opacity-90
        focus:outline-none
        focus:ring-2
        focus:ring-black
        focus:ring-offset-2
        "
    >
        Show More
    </button>

    </div>

</div>

{% schema %}
{
  "name": "Best Seller",
  "tag": "section",
  "class": "section",
  "settings": [
    {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
    },
    {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Best Seller"
    }
  ],
  "presets": [
    {
      "name": "Best Seller"
    }
  ]
}
{% endschema %}
